From a75cde505c8e690cb4a1f2357d32803f7c1f606e Mon Sep 17 00:00:00 2001
From: eirikr <151315375+Oichkatzelesfrettschen@users.noreply.github.com>
Date: Wed, 23 Sep 2026 00:23:52 -0700
Subject: [PATCH 1/2] maguro, tuna: install blobs as prebuilt modules

Android 11 refuses ELF files in PRODUCT_COPY_FILES, so each blob becomes a
BUILD_PREBUILT module whose LOCAL_SHARED_LIBRARIES lists its DT_NEEDED
entries for the ELF check. The Widevine L3 blobs stay out: they link
libstagefright, libdrmframework and libprotobuf-cpp-lite and import 34
android:: C++ symbols from the 4.x ABI, none of which the port shims.
libfrsdk serves only the removed face-unlock app.

Assisted-by: Claude Code (claude-opus)
Change-Id: I007a71959321a5d2617edc46a20d18d4fd51f212
---
 maguro/Android.mk             | 46 +++++++++++++++++++++++++++++++++++
 maguro/maguro-vendor-blobs.mk | 21 ----------------
 maguro/maguro-vendor.mk       | 26 +++++---------------
 tuna/Android.mk               | 42 ++++++++++++++++++++++++++++++++
 tuna/tuna-vendor-blobs.mk     | 41 -------------------------------
 tuna/tuna-vendor.mk           | 26 ++++++--------------
 6 files changed, 102 insertions(+), 100 deletions(-)
 create mode 100644 maguro/Android.mk
 delete mode 100644 maguro/maguro-vendor-blobs.mk
 create mode 100644 tuna/Android.mk
 delete mode 100644 tuna/tuna-vendor-blobs.mk

diff --git a/maguro/Android.mk b/maguro/Android.mk
new file mode 100644
index 0000000..5b6ae1e
--- /dev/null
+++ b/maguro/Android.mk
@@ -0,0 +1,46 @@
+# Proprietary files for the GSM variant (GT-I9250).
+
+LOCAL_PATH := $(call my-dir)
+
+ifeq ($(TARGET_DEVICE),maguro)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := libsec-ril
+LOCAL_MODULE_OWNER := samsung
+LOCAL_SRC_FILES := proprietary/vendor/lib/libsec-ril.so
+LOCAL_MODULE_SUFFIX := .so
+LOCAL_MODULE_CLASS := SHARED_LIBRARIES
+LOCAL_MODULE_TARGET_ARCH := arm
+LOCAL_SHARED_LIBRARIES := libbinder libcutils liblog libril libsecril-compat libstdc++
+LOCAL_VENDOR_MODULE := true
+include $(BUILD_PREBUILT)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := gps.omap4
+LOCAL_MODULE_OWNER := samsung
+LOCAL_SRC_FILES := proprietary/vendor/lib/hw/gps.omap4.so
+LOCAL_MODULE_SUFFIX := .so
+LOCAL_MODULE_CLASS := SHARED_LIBRARIES
+LOCAL_MODULE_TARGET_ARCH := arm
+LOCAL_MODULE_RELATIVE_PATH := hw
+LOCAL_SHARED_LIBRARIES := libcrypto libcutils liblog libssl libstdc++ libutils
+LOCAL_VENDOR_MODULE := true
+include $(BUILD_PREBUILT)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := sirfgps.conf
+LOCAL_MODULE_OWNER := samsung
+LOCAL_SRC_FILES := proprietary/vendor/etc/sirfgps.conf
+LOCAL_MODULE_CLASS := ETC
+LOCAL_VENDOR_MODULE := true
+include $(BUILD_PREBUILT)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := bcm4330.hcd
+LOCAL_MODULE_OWNER := samsung
+LOCAL_SRC_FILES := proprietary/vendor/firmware/bcm4330.hcd
+LOCAL_MODULE_CLASS := ETC
+LOCAL_MODULE_PATH := $(TARGET_OUT_VENDOR)/firmware
+include $(BUILD_PREBUILT)
+
+endif
