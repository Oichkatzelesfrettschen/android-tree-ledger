diff --git a/mtp/ffs/MtpDevHandle.cpp b/mtp/ffs/MtpDevHandle.cpp
index e22ba55..f55eb5c 100644
--- a/mtp/ffs/MtpDevHandle.cpp
+++ b/mtp/ffs/MtpDevHandle.cpp
@@ -60,6 +60,9 @@ int MtpDevHandle::sendEvent(mtp_event me) {
 }
 
 int MtpDevHandle::start(bool /* ptp */) {
+	// f_mtp's mtp_open admits one opener and returns -EBUSY to a second, so a
+	// descriptor passed in at construction stays in use.
+	if (mFd != -1) return 0;
 	mFd.reset(TEMP_FAILURE_RETRY(open(mtp_dev_path, O_RDWR)));
 	if (mFd == -1) return -1;
 	return 0;
diff --git a/mtp/ffs/mtp_MtpServer.cpp b/mtp/ffs/mtp_MtpServer.cpp
index ce890d1..75a441d 100755
--- a/mtp/ffs/mtp_MtpServer.cpp
+++ b/mtp/ffs/mtp_MtpServer.cpp
@@ -74,7 +74,9 @@ void twmtp_MtpServer::start()
 		MTPD("Opening FFS EPO\n");
 		controlFd = open(FFS_MTP_EP0, O_RDWR);
 	} else {
-		controlFd = open(mtp_device, O_WRONLY);
+		/* MtpDevHandle reads and writes through this descriptor; f_mtp
+		 * admits one opener at a time (open_excl). */
+		controlFd = open(mtp_device, O_RDWR);
 	}
 	if (controlFd < 0) {
 		MTPE("could not open MTP driver, errno: %d\n", errno);
