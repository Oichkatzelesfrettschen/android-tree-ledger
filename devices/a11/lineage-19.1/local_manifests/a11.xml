  <!-- HTC Desire 510 (a11chl) on LineageOS 19.1: copied into
       .repo/local_manifests/ of an independent lineage-19.1 checkout
       ($HOME/Projects/Android/trees/desire510-19.1); see
       notes/LINEAGE_19_1_PORT_PLAN.md. Every fork project is pinned by SHA to
       its merged head, with upstream naming the branch that carries it: the
       kernel on lineage-18.1-kernel, the device trees and the 3.4 legacy
       userspace set (system/bpf, system/netd, art, bionic, frameworks/av,
       frameworks/base, hardware/ril, build/soong) on their lineage-19.1 or
       AOSP base branches, and the msm8974 CAF HALs on
       lineage-19.1-caf-msm8974. The display HAL, qcom-common and timekeep
       carry no a11 change and are pinned to the verified tips of their
       branches, so a sync cannot move a project under the build jobs' head
       checks. -->
  <remote name="oich" fetch="https://github.com/Oichkatzelesfrettschen" review="github.com/Oichkatzelesfrettschen" />

  <remove-project name="LineageOS/android_build_soong" />
  <project path="build/soong" name="android_build_soong" remote="oich"
           revision="8310059358814b6a70f1c41b201497c5335792ed" upstream="lineage-19.1" groups="pdk,tradefed">
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <!-- Linux 3.4 legacy userspace: LineageOS-UL commits on the current
       LineageOS (or the manifest's AOSP r22) revision. -->
